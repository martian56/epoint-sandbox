# Copy to .env for local development. The Docker image works without any of these.

EPOINT_PORT=8181

# Point at your own Postgres to skip the bundled one.
EPOINT_DATABASE_URL=postgresql+psycopg://epoint:epoint@localhost:5432/epoint_sandbox

# Used to build redirect_url values handed back to your integration.
EPOINT_PUBLIC_BASE_URL=http://localhost:8181

EPOINT_CALLBACK_TIMEOUT_SECONDS=10
EPOINT_CALLBACK_MAX_ATTEMPTS=4

# Set false to start with an empty merchant table.
EPOINT_SEED_MERCHANTS=true

# Set both to require a login for the dashboard. Leave unset for local work.
# EPOINT_ADMIN_EMAIL=admin@example.com
# EPOINT_ADMIN_PASSWORD=
EPOINT_SESSION_TTL_HOURS=12
