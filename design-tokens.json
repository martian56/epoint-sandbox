{
  "$comment": "Single source of truth for design tokens. Measured from the epoint dashboard. Run 'bun run tokens' after editing.",
  "color": {
    "brand": "#b83b8c",
    "brand-bright": "#c54697",
    "brand-deep": "#620046",
    "brand-mid": "#932f71",
    "brand-hover": "#9b3276",

    "tint-50": "#fcf7fb",
    "tint-100": "#ffebf4",
    "tint-200": "#ffd8eb",

    "ink": "#000000",
    "body": "#4a4a4a",
    "muted": "#645c5f",
    "subtle": "#9c9c9c",

    "line": "#ebe9e9",
    "line-strong": "#dedede",
    "surface": "#ffffff",
    "canvas": "#fcfcfc",
    "surface-alt": "#f7f7f7",

    "success": "#28a745",
